# Copy this file to ".env" and fill it in. NEVER commit the real .env.

# ---- AI grading (optional but recommended) ----
# Free Gemini key (no credit card): https://aistudio.google.com  ->  "Get API key"
# Without it, the app uses an offline mock grader so it still runs.
GEMINI_API_KEY=paste-your-key-here

# ---- Shared progress via Turso (recommended; free tier) ----
# Makes progress shared across the crew from any device. The server creates its
# own tables on first boot, so these two values are the whole setup.
# Get them with the Turso CLI (https://docs.turso.tech):
#   turso db create the-forge
#   turso db show the-forge --url        -> TURSO_DATABASE_URL
#   turso db tokens create the-forge     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Shared progress via Supabase (legacy alternative) ----
# Only used when the TURSO_* values above are blank. Needs supabase-schema.sql
# run once in the SQL editor. Use the *service_role* key (SECRET — server-side
# only, NOT the anon/public key): Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# If BOTH pairs are blank the app stores progress in a local file instead
# (single-server only — wiped on restart when deployed to Render's free tier).

# ---- Optional overrides ----
# FORGE_MODEL=gemini-2.0-flash
# PORT=3000
# SUPABASE_TABLE=forge_progress
# SUPABASE_SPRITE_TABLE=forge_sprites
