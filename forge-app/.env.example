# Copy this file to ".env" and fill it in. NEVER commit the real .env.

# ---- AI grading (optional but recommended) ----
# Free Gemini key (no credit card): https://aistudio.google.com  ->  "Get API key"
# Without it, the app uses an offline mock grader so it still runs.
GEMINI_API_KEY=paste-your-key-here

# ---- Shared progress via Supabase (optional; free tier) ----
# Makes progress shared across the crew from any device. If BOTH are blank, the
# app stores progress in a local file instead (single-server only).
# Get these in Supabase: Project Settings -> API.
#   SUPABASE_URL          = your Project URL  (https://xxxx.supabase.co)
#   SUPABASE_SERVICE_KEY  = the *service_role* key (SECRET — server-side only,
#                           NOT the anon/public key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Optional overrides ----
# FORGE_MODEL=gemini-2.0-flash
# PORT=3000
# SUPABASE_TABLE=forge_progress
