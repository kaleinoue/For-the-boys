# 🔐 SECRETS — never commit these (Quest 11 explains why in blood)
.env
.env.*
!.env.example
*.key
creds/
secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Node / build junk
node_modules/
dist/
build/

# Forge app runtime data (shared progress store — regenerated at runtime)
forge-app/data/progress.json
# Hand-made Supabase exports for the Turso migration. They hold the crew's whole
# progress, and they're made by pasting into an editor — which is exactly how the
# wrong clipboard ends up in the repo. Nothing here ever needs committing.
forge-app/export*.json
# Sprite art written by the local-file store (the hosted stores keep their own copy)
forge-app/data/sprites/

# WhatsApp relay session/cache (never commit — it's a live login to your account)
whatsapp-relay/.wwebjs_auth/
whatsapp-relay/.wwebjs_cache/

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
