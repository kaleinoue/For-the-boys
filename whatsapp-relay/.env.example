# Copy to ".env". None of this is secret, but keep it local anyway.
FORGE_URL=https://the-forge-yy5i.onrender.com

# The EXACT name of the WhatsApp group to post into. If you get it wrong, the
# relay prints your group names on startup so you can copy the right one.
WHATSAPP_GROUP=For The Boys

# How often (ms) to check the app for XP changes. 45s is polite; don't go tiny.
POLL_MS=45000
